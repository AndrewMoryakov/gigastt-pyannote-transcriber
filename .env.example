# Create .env from this file. Never commit .env.
#
# Setting HF_TOKEN for the current PowerShell process only is preferred; this
# file is the fallback for when that is inconvenient. It is ignored by Git and
# checked for by scripts/check-repo-hygiene.ps1.

# Read token from https://huggingface.co/settings/tokens, after accepting the
# conditions of pyannote/speaker-diarization-community-1.
HF_TOKEN=hf_REPLACE_WITH_YOUR_READ_TOKEN

# Keep all Hugging Face artifacts inside the ignored models/ directory. Read by
# the huggingface_hub library itself, so it must be set before the run starts.
HF_HOME=models/huggingface

# The pyannote model and its revision are NOT configurable here: they are pinned
# in src/fourvoices/diarize.py and tools/tools.lock.json, and the CLI refuses a
# configuration that asks for anything else.
