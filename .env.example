# Create .env from this file. Never commit .env.
# Read token from https://huggingface.co/settings/tokens
HF_TOKEN=hf_REPLACE_WITH_YOUR_READ_TOKEN

# Pinned gated pyannote model. Normally there is no need to change these.
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
PYANNOTE_REVISION=3533c8cf8e369892e6b79ff1bf80f7b0286a54ee

# Keep all Hugging Face artifacts inside the ignored models/ directory.
HF_HOME=models/huggingface
